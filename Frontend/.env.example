# ===========================================
# RepoIQ Frontend Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# API CONFIGURATION
# ===========================================
# Local development
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Production (update with your deployed backend URL)
# VITE_API_BASE_URL=https://api.your-domain.com/api/v1

# ===========================================
# GITHUB OAUTH (Optional - for direct client-side auth)
# ===========================================
# Usually handled by backend, but can be configured here for SPA flows
# VITE_GITHUB_CLIENT_ID=your-github-client-id
# VITE_GITHUB_REDIRECT_URI=http://localhost:8081/auth/github/callback

# ===========================================
# FEATURE FLAGS
# ===========================================
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_CHAT=true

# ===========================================
# ERROR TRACKING (Optional)
# ===========================================
# VITE_SENTRY_DSN=https://your-sentry-dsn
