# ===========================================
# RepoIQ Frontend Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values. Never commit .env.
#
# Everything prefixed VITE_ is baked into the JavaScript bundle at BUILD time
# and is visible to anyone who opens the site - never put secrets here.
# Changing a VITE_ value needs a rebuild, not just a restart.

# -------------------------------------------
# API (required)
# -------------------------------------------
# Base URL of the backend API, including the /api/v1 prefix. Read by
# src/lib/api.ts. A production build without it fails on load with a clear
# error rather than silently calling localhost.
#
# server.js also reads this at RUNTIME to allow the API origin in the
# Content-Security-Policy (connect-src/img-src), so set it on the service for
# both build and run (Railway and Nixpacks share variables between the two).
#
# Production: the deployed backend over https, e.g.
#   VITE_API_BASE_URL=https://api.your-domain.com/api/v1
# The backend's ALLOWED_ORIGINS must include this site's origin.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# -------------------------------------------
# Production server (server.js, `npm start`) - runtime only
# -------------------------------------------
# PORT is provided by the platform; defaults to 4173.
# PORT=4173
# HOST to bind; unset listens on all interfaces (IPv4 and IPv6).
# HOST=0.0.0.0
