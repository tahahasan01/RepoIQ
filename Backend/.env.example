# ===========================================
# RepoIQ Backend Environment Configuration
# ===========================================
# Copy to .env (or into your platform's secret store) and fill in every value
# marked REQUIRED. NEVER commit a real .env to version control.
#
# This template is written for a PRODUCTION deploy. With APP_ENV=production the
# process refuses to start - and lists every problem - if SECRET_KEY is weak or
# a placeholder, TOKEN_ENCRYPTION_KEY is missing, ALLOWED_ORIGINS contains a
# localhost or plain-http origin, DEBUG is on, or no Anthropic credential is
# set (see _reject_dev_only_settings_in_production in app/core/config.py).
#
# LOCAL DEVELOPMENT: set APP_ENV=development, ALLOWED_ORIGINS=http://localhost:8080
# and GITHUB_REDIRECT_URI=http://localhost:8080/auth/github/callback. None of
# the production checks apply then, and /docs is served.

# ===========================================
# APPLICATION
# ===========================================
APP_NAME=RepoIQ
# production | development. Drives the boot checks above, HSTS, and whether
# the API docs are served.
APP_ENV=production
# Older name for the same idea; keep it equal to APP_ENV.
ENVIRONMENT=production
# Must be false in production: debug mode puts exception text in 500 responses.
DEBUG=false
HOST=0.0.0.0
PORT=8000
# Used only by `python main.py`; the Procfile / railway.toml run uvicorn directly.
WORKERS=4
# Serve /docs, /redoc and /openapi.json in production. They publish every
# route, including the admin ones; leave false unless you mean it.
ENABLE_API_DOCS=false

# Email + password accounts. Leave false: RepoIQ signs in with GitHub only.
# There is no email delivery, so password accounts have no reset or verification.
PASSWORD_AUTH_ENABLED=false

# ===========================================
# POSTGRESQL (REQUIRED)
# ===========================================
# Apply the schema with `python -m app.db.migrate` (the Procfile release step
# and railway.toml preDeployCommand do this on every deploy).
DATABASE_URL=postgresql://repoiq:CHANGE-ME@db.internal:5432/repoiq
# Postgres has a hard max_connections (100 by default) shared by every API
# worker AND every Celery worker: keep processes x DB_POOL_MAX_SIZE well under it.
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
# Seconds a request waits for a pooled connection before failing.
DB_POOL_TIMEOUT=10

# ===========================================
# REDIS (REQUIRED)
# ===========================================
# Cache, rate limiting, session revocation, and the Celery broker/result store.
# Use a password and TLS (rediss://) when Redis is not on a private network.
REDIS_URL=rediss://:CHANGE-ME@redis.internal:6379/0
# Cache connection pool size per process, and seconds before a Redis
# read / connect is abandoned (the app then degrades to uncached).
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=2

# ===========================================
# SECURITY (REQUIRED)
# ===========================================
# Signs every session token. At least 32 random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Encrypts stored GitHub tokens. Required in production and must differ from
# SECRET_KEY, so the signing key can be rotated without losing stored tokens.
# Generate it the same way. Tokens written before it was set stay readable.
TOKEN_ENCRYPTION_KEY=
# Enables the operational endpoints (/metrics, /api/v1/cache/*), sent as
# X-Admin-Key. Unset = those endpoints return 404.
ADMIN_API_KEY=
# Reverse proxies in front of the app. X-Forwarded-For is honoured only when
# this is > 0. Railway / Render / Fly / a single load balancer: 1.
TRUSTED_PROXY_COUNT=1
ALGORITHM=HS256
# Access token lifetime (minutes) and refresh token lifetime (days).
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# CORS (REQUIRED)
# ===========================================
# Comma-separated https:// origin(s) of the frontend - scheme and host only, no
# path or trailing slash. localhost, 127.0.0.1, plain http:// and * are refused
# in production: credentialed CORS lets an allowed origin read every
# authenticated response.
ALLOWED_ORIGINS=https://app.your-domain.com
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With,Accept,Origin

# ===========================================
# GITHUB (REQUIRED)
# ===========================================
# oauth (an OAuth App) | app (a GitHub App: per-repository grants and 1-hour
# installation tokens - the least-privilege option; see GITHUB_APP_MIGRATION.md).
GITHUB_AUTH_MODE=oauth
# OAuth App credentials: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The frontend's callback page. Must match the OAuth App's callback URL exactly;
# https:// in production.
GITHUB_REDIRECT_URI=https://app.your-domain.com/auth/github/callback
# `repo` is required to read PRIVATE repositories and open auto-fix PRs.
# Public-only deployments can use "public_repo read:user user:email".
GITHUB_OAUTH_SCOPES=repo read:user user:email
# Required when GITHUB_AUTH_MODE=app:
# GITHUB_APP_ID=123456
# GITHUB_APP_SLUG=your-app-slug
# PEM key; escaped newlines (\n) are accepted, as most secret stores need them.
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# The GitHub App's own client id/secret; fall back to GITHUB_CLIENT_ID/SECRET.
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# Most repositories one sync lists; above this the listing is partial.
GITHUB_SYNC_MAX_REPOS=1000

# ===========================================
# CLAUDE (ANTHROPIC) (REQUIRED)
# ===========================================
# anthropic is the only provider a deployed service may use. (claude_agent_sdk
# runs on a developer's own Claude Code login and is refused in production.)
LLM_PROVIDER=anthropic
# A Console API key: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Alternative to ANTHROPIC_API_KEY (an OAuth access token). Set only one.
# ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Code review is intelligence-sensitive.
ANTHROPIC_EFFORT=high
# Re-run a refused request on Anthropic's recommended fallback model.
ANTHROPIC_REFUSAL_FALLBACK=true
# Max seconds between streamed chunks before a call is treated as hung.
ANTHROPIC_TIMEOUT_SECONDS=300
# Output ceiling per model call, thinking included. Too low and the model stops
# mid-JSON and the batch is recorded as failed.
LLM_MAX_OUTPUT_TOKENS=32000
# Rolling daily token allowance per user; 0 disables the cap (unbounded spend).
LLM_DAILY_TOKEN_BUDGET_PER_USER=2000000

# ===========================================
# ANALYSIS
# ===========================================
# queue (Celery - correct for production, needs a worker service) | inline
# (in the API process, local dev only) | auto (queue when a worker answers).
#   celery -A app.core.celery_app worker --loglevel=info -Q celery,analysis
ANALYSIS_EXECUTION_MODE=queue
# Analysis reads a SAMPLE of each repository; results report files_analyzed and
# files_eligible. Cost and time scale roughly linearly with this.
ANALYSIS_MAX_FILES=150
# Files per model call: fewer calls when larger, better recall when smaller.
ANALYSIS_BATCH_SIZE=8
# Files larger than this (bytes) are skipped.
ANALYSIS_MAX_FILE_BYTES=51200
# Developer insights: weeks of history kept current, and files blamed per run
# (one GitHub GraphQL request each).
INSIGHTS_WEEKS=12
INSIGHTS_MAX_BLAME_FILES=40

# ===========================================
# ALERTS
# ===========================================
# Seconds between scheduled organisation alert checks; 0 disables the schedule.
# Needs a beat process:  celery -A app.core.celery_app beat --loglevel=info
# The quality-score threshold is each user's own (Settings > Notifications).
ALERT_CHECK_INTERVAL_SECONDS=3600

# ===========================================
# UPLOADS
# ===========================================
# Max avatar upload size in bytes.
MAX_UPLOAD_SIZE=5242880
# Avatars are written here and served from AVATAR_BASE_URL. Local disk is
# single-instance only: use a persistent volume, or object storage (swap the
# backend in app/services/local_storage.py) before running more than one.
UPLOAD_DIR=uploads
AVATAR_BASE_URL=/static/avatars
