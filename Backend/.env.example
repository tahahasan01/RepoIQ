# ===========================================
# RepoIQ Backend Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# APPLICATION SETTINGS
# ===========================================
APP_NAME=RepoIQ
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ===========================================
# SUPABASE DATABASE
# ===========================================
# Get these from Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Direct PostgreSQL connection (for Alembic migrations)
# Get from Supabase Dashboard > Settings > Database
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ===========================================
# GITHUB OAUTH
# ===========================================
# Create OAuth App: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# Must match BOTH the callback URL on your GitHub OAuth app AND the port the
# frontend dev server actually serves on (Vite is configured for 8080).
GITHUB_REDIRECT_URI=http://localhost:8080/auth/github/callback
# `repo` is required to read PRIVATE repositories (an OAuth App has no read-only
# private scope) and to open auto-fix pull requests. Deployments that only ever
# analyse public repos can use "public_repo read:user user:email".
GITHUB_OAUTH_SCOPES=repo read:user user:email

# ===========================================
# OPENAI API
# ===========================================
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# Output ceiling per model call. Too low and the model stops mid-JSON, the parse
# fails, and the batch silently reports zero issues.
OPENAI_MAX_OUTPUT_TOKENS=8000
# Rolling daily token allowance per user; 0 disables the cap.
OPENAI_DAILY_TOKEN_BUDGET_PER_USER=2000000

# ===========================================
# REDIS CACHING
# ===========================================
# Local: redis://localhost:6379/0
# Docker: redis://redis:6379/0
# Cloud: redis://:password@host:port/0
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ===========================================
# SECURITY
# ===========================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production
# Separate key for encrypting GitHub tokens at rest, so SECRET_KEY (JWT signing)
# can be rotated without making every stored token undecryptable.
TOKEN_ENCRYPTION_KEY=
# Required to enable the operational endpoints (/metrics, /api/v1/cache/*).
# Leave unset and those endpoints return 404 - they are NOT open without it.
ADMIN_API_KEY=
# Number of trusted reverse proxies in front of the app. X-Forwarded-For is
# only honoured when this is > 0. Railway/Vercel/Cloudflare: usually 1.
TRUSTED_PROXY_COUNT=0
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# CORS SETTINGS
# ===========================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_PER_MINUTE=60

# ===========================================
# FILE UPLOAD
# ===========================================
# Analysis reads a SAMPLE of each repository. The result reports files_analyzed
# and files_eligible so the UI can disclose the sample size.
ANALYSIS_MAX_FILES=15
ANALYSIS_MAX_FILE_BYTES=51200

MAX_UPLOAD_SIZE=5242880
UPLOAD_DIR=uploads
